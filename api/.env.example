# Postgres with PostGIS. These defaults are the docker-compose service — port
# 5433, so it cannot be confused with a local PostgreSQL on 5432.
# Neon: create the branch and point this at it; the first migration creates the
# postgis extension itself, so there is nothing to run by hand.
DATABASE_URL="postgresql://fako:fako@localhost:5433/fako_ride"

# Redis — driver positions and the dispatch offer queue. Upstash works.
REDIS_URL="redis://localhost:6379"

# Signing key for rider/driver tokens. Must be at least 16 characters, and the
# API refuses to boot otherwise. Generate a real one: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-before-anything-real"
JWT_TTL="30d"

PORT=4000
NODE_ENV=development

# --- SMS -------------------------------------------------------------------
# OTP is the only login that works in this market. Provider is NOT chosen yet:
# price local Cameroonian aggregators per SMS before committing — it is a
# recurring cost on every signup. Until then "console" prints the code to logs.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="FAKORIDE"

# --- Mobile money ----------------------------------------------------------
# "fake" moves no money and is the default, because an environment without
# credentials must never behave as though it had them. Switch to "fapshi" only
# once the two values below are filled in — asking for fapshi without them is a
# startup error, not a silent fall back.
MOMO_PROVIDER="fake"

# Fapshi is Cameroonian and covers MTN MoMo and Orange Money through one API.
# Direct Pay (collecting) and payouts are each switched on per account by asking
# Fapshi support; both work in sandbox out of the box.
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# https://sandbox.fapshi.com while true, https://live.fapshi.com when false.
FAPSHI_SANDBOX="true"
# Generate one, set it on the Fapshi dashboard, and put the same value here.
# It arrives as the x-wh-secret header; without it every webhook is refused,
# which is the safe failure — the reconciler below still settles payments.
FAPSHI_WEBHOOK_SECRET=""

# How long to wait for a webhook before asking the provider ourselves.
PAYMENT_RECONCILE_AFTER_SECONDS=45

# --- Commercial ------------------------------------------------------------
# Flat daily access fee in XAF. Not a commission — see README.
ACCESS_FEE_XAF=500
# Discount applied when the rider pays by mobile money instead of cash.
MOBILE_PAYMENT_DISCOUNT_XAF=15
# How long a driver has to accept an offer before it moves to the next driver.
OFFER_TTL_SECONDS=12
# How far from the pickup point we look for drivers, in metres.
DISPATCH_RADIUS_M=2500
