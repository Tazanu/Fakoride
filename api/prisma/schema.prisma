// Fako Ride data model.
//
// Two conventions run through all of it:
//   * Money is an integer number of XAF. The franc has no subunit.
//   * Geography is zone-shaped. Nobody in Buea navigates by street address, so a
//     zone (Molyko, Great Soppo, Mile 17) is the primary spatial unit and a
//     landmark is how a human names a point inside one.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

/// Buea runs on shared taxis; Limbe and Tiko run on motos. CAR is the default
/// because Buea is the launch town — MOTO stays so the other towns are a config
/// change and not a migration.
enum VehicleType {
  MOTO
  CAR
}

/// Recorded only so a rider who asks for a woman driver can be matched with one.
/// Never shown on a profile and never used for anything else.
enum DriverGender {
  UNSPECIFIED
  WOMAN
  MAN
}

enum DriverStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum TripStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_RIDER
  CANCELLED_BY_DRIVER
  NO_DRIVER_FOUND
}

enum PaymentMethod {
  CASH
  MOMO
  ORANGE_MONEY
}

enum FareSource {
  /// Generated by the seed formula. Provisional — replace by walking the corridor.
  FORMULA
  /// Set by a human who priced this pair on the ground. The formula never overwrites it.
  FIELD
}

enum LedgerType {
  /// Fare the rider handed to the driver directly. We never touched the money.
  FARE_CASH
  /// Fare collected through MoMo or Orange Money.
  FARE_MOBILE
  /// The flat daily access fee. The only thing we actually charge for.
  ACCESS_FEE
  /// Money sent out to the driver's own MoMo. Reduces what we still owe him.
  PAYOUT
  ADJUSTMENT
}

/// What a movement of real money is for.
enum PaymentPurpose {
  /// A rider paying a fare by MoMo instead of cash. We hold it until payout.
  TRIP_FARE
  /// The daily access fee, debited from the driver.
  ACCESS_FEE
  /// Paying a driver what we are holding for him.
  DRIVER_PAYOUT
}

/// Fapshi's own status values, kept verbatim rather than translated. A payment
/// processor's vocabulary is the one place to be literal — inventing our own
/// names for its states is how reconciliation goes wrong.
enum PaymentStatus {
  CREATED
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

/// Every change an admin makes to a driver's standing. Append-only, like trips:
/// suspending somebody's livelihood is not a field you silently overwrite.
enum DriverReviewAction {
  VERIFIED
  REJECTED
  SUSPENDED
  REINSTATED
}

enum SosStatus {
  RAISED
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum ComplaintCategory {
  FARE_DISPUTE
  DRIVER_CONDUCT
  RIDER_CONDUCT
  SAFETY
  LOST_ITEM
  APP_PROBLEM
  OTHER
}

enum ComplaintStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum NoticeSeverity {
  INFO
  WARNING
  SERVICE_SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  /// E.164, e.g. +237670000000. The only identity that works in this market.
  phone     String   @unique
  name      String?
  role      UserRole @default(RIDER)
  language  String   @default("en")
  /// A key into the document store, or null. Not a URL: the bytes are served
  /// by us, to people entitled to see them, and never linked publicly.
  photoKey  String?
  photoAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver     Driver?
  ridesTaken Trip[]      @relation("RiderTrips")
  sosAlerts  SosAlert[]
  complaints Complaint[]

  @@index([role])
}

model Driver {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType    VehicleType  @default(CAR)
  gender         DriverGender @default(UNSPECIFIED)
  /// A second helmet, on a moto. Meaningless for a taxi and always false there;
  /// kept because Limbe and Tiko run motos and will need it again.
  hasSpareHelmet Boolean      @default(false)
  /// Registration plate as painted on the vehicle — the rider checks it before getting in.
  plate          String
  cniNumber      String
  /// The S10. A paid moto trip cannot legally be dispatched without one, so an
  /// admin cannot mark a driver ACTIVE without typing the number off the card.
  licenceNumber  String?
  status         DriverStatus @default(PENDING_REVIEW)
  verifiedAt     DateTime?

  rating      Float @default(5)
  ratingCount Int   @default(0)
  tripCount   Int   @default(0)

  online     Boolean   @default(false)
  lastSeenAt DateTime?
  homeZoneId String?
  homeZone   Zone?     @relation(fields: [homeZoneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips      Trip[]
  ledger     LedgerEntry[]
  accessFees AccessFeeCharge[]
  reviews    DriverReview[]
  documents  DriverDocument[]
  payments   Payment[]

  @@index([status, online])
  @@index([plate])
}

model Zone {
  id   String @id @default(cuid())
  /// Stable machine code, e.g. MOLYKO. Used in the fare table and in the apps.
  code String @unique
  name String
  town String @default("Buea")

  centroidLat Float
  centroidLng Float
  /// Metres above sea level. This is what makes a fare a hill fare.
  elevationM  Int

  /// Drawn boundary. Null until someone traces it; fare lookup falls back to
  /// nearest centroid, which is good enough to launch one corridor.
  boundary Unsupported("geography(Polygon, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  landmarks Landmark[]
  faresFrom Fare[]          @relation("FareFromZone")
  faresTo   Fare[]          @relation("FareToZone")
  tripsFrom Trip[]          @relation("TripFromZone")
  tripsTo   Trip[]          @relation("TripToZone")
  drivers   Driver[]
  notices   ServiceNotice[]
}

model Landmark {
  id     String @id @default(cuid())
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  name    String
  /// What people actually call it. "Checkpoint" is also "Check Point", "CP".
  aliases String[] @default([])

  lat Float
  lng Float

  /// Somewhere a bike can actually stop and wait.
  isPickupPoint Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([zoneId, name])
  @@index([name])
}

/// One directed zone pair at one price. Directed because climbing costs more
/// than descending the same road, which is how Buea has always priced.
model Fare {
  id          String      @id @default(cuid())
  fromZoneId  String
  fromZone    Zone        @relation("FareFromZone", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZoneId    String
  toZone      Zone        @relation("FareToZone", fields: [toZoneId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @default(CAR)

  priceXaf Int
  source   FareSource @default(FORMULA)
  note     String?

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([fromZoneId, toZoneId, vehicleType])
  @@index([source])
}

model Trip {
  id      String @id @default(cuid())
  riderId String
  rider   User   @relation("RiderTrips", fields: [riderId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  fromZoneId String
  fromZone   Zone   @relation("TripFromZone", fields: [fromZoneId], references: [id])
  toZoneId   String
  toZone     Zone   @relation("TripToZone", fields: [toZoneId], references: [id])

  pickupLat   Float
  pickupLng   Float
  pickupLabel String
  dropLat     Float?
  dropLng     Float?
  dropLabel   String

  /// Quoted before the rider committed, and never recalculated afterwards.
  priceXaf      Int
  paymentMethod PaymentMethod @default(CASH)
  vehicleType   VehicleType   @default(CAR)

  /// Booking preferences. Both narrow who may be offered the trip; neither
  /// changes the price, because the price is the zone pair and nothing else.
  needsHelmet     Boolean @default(false)
  womanDriverOnly Boolean @default(false)

  status TripStatus @default(REQUESTED)

  /// Four digits the rider reads out at the meeting point. Verifying it is what
  /// starts the trip — it is both the safety check and the anti-fraud check.
  pin         String
  pinVerified Boolean @default(false)

  /// Drivers already offered this trip, so we never re-offer to the same one.
  offeredDriverIds String[] @default([])

  requestedAt  DateTime  @default(now())
  acceptedAt   DateTime?
  arrivedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  events     TripEvent[]
  ledger     LedgerEntry[]
  shares     TripShare[]
  sosAlerts  SosAlert[]
  complaints Complaint[]
  payments   Payment[]

  @@index([riderId, requestedAt])
  @@index([driverId, requestedAt])
  @@index([status])
}

/// Append-only. A phone that loses signal mid-trip must never lose the record.
model TripEvent {
  id     String     @id @default(cuid())
  tripId String
  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status TripStatus
  at     DateTime   @default(now())
  actor  String?
  meta   Json?

  @@index([tripId, at])
}

model LedgerEntry {
  id       String  @id @default(cuid())
  driverId String
  driver   Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId   String?
  trip     Trip?   @relation(fields: [tripId], references: [id])

  type      LedgerType
  /// Positive is money to the driver, negative is money from the driver.
  amountXaf Int
  note      String?
  createdAt DateTime   @default(now())

  @@index([driverId, createdAt])
  @@index([type])
}

/// One row per driver per service day they actually worked. Never generated for
/// a day a driver stayed off the road — a ghost-town Monday costs him nothing.
model AccessFeeCharge {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  serviceDate DateTime  @db.Date
  amountXaf   Int
  paid        Boolean   @default(false)
  paidAt      DateTime?
  providerRef String?
  failureCode String?

  createdAt DateTime  @default(now())
  payments  Payment[]

  @@unique([driverId, serviceDate])
  @@index([paid])
}

/// Powers the "service status today" banner. Set by ops, read by both apps.
model ServiceNotice {
  id        String         @id @default(cuid())
  zoneId    String?
  zone      Zone?          @relation(fields: [zoneId], references: [id])
  message   String
  messageFr String?
  severity  NoticeSeverity @default(INFO)

  activeFrom  DateTime  @default(now())
  activeUntil DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([activeFrom, activeUntil])
}

/// A live link to one trip, for one person the rider chose.
///
/// Deliberately a row and not a signed token: the rider has to be able to take
/// it back, and a JWT that has left the phone cannot be taken back. It dies on
/// its own when the trip ends, so a link forwarded to a group chat is worthless
/// an hour later.
model TripShare {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// The opaque half of the URL. Unguessable, and the only credential it needs.
  token           String  @unique
  /// Who the rider says they sent it to — shown back to them as "Mum is watching".
  sharedWithLabel String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  /// Bumped on every read, so the rider can be told the link was actually opened.
  viewCount Int       @default(0)

  @@index([tripId])
}

/// The red button on the trip screen.
///
/// Raised by either side, never auto-resolved, and answered by a human. The
/// position is copied in at the moment it is pressed rather than read later,
/// because the phone that raised it may go dark immediately afterwards.
model SosAlert {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  raisedByUserId String
  raisedBy       User   @relation(fields: [raisedByUserId], references: [id])
  /// RIDER or DRIVER — which side of the trip pressed it.
  raisedByRole   String

  lat  Float?
  lng  Float?
  note String?

  status     SosStatus @default(RAISED)
  raisedAt   DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  outcome    String?

  @@index([status, raisedAt])
  @@index([tripId])
}

/// "Something wrong?" — the thing a phone call to a bendskin cannot offer.
///
/// The promise on the screen is that a human answers within a day, so this
/// carries a due time from the moment it is filed and ops is measured on it.
model Complaint {
  id     String  @id @default(cuid())
  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  category ComplaintCategory
  message  String
  status   ComplaintStatus   @default(OPEN)

  createdAt  DateTime  @default(now())
  /// createdAt + 24h. Stored rather than computed so the queue can sort on it.
  respondBy  DateTime
  answeredAt DateTime?
  response   String?
  handledBy  String?

  @@index([status, respondBy])
  @@index([userId, createdAt])
}

/// One row per decision an admin took about a driver.
///
/// The Driver row carries the current status because dispatch reads it on every
/// offer, but the reason a driver is suspended — and who suspended him — lives
/// here and is never overwritten. Taking somebody's livelihood away is not a
/// field you silently flip.
model DriverReview {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  action DriverReviewAction
  /// The admin's user id. Never a service account: a person decided this.
  by     String
  note   String?
  at     DateTime           @default(now())

  @@index([driverId, at])
}

/// One attempt to move real money, and everything the provider said about it.
///
/// Separate from LedgerEntry on purpose. The ledger is what a driver is owed and
/// owes — our arithmetic, which must always balance. This is what a third party
/// did with a phone number, which can be PENDING for a minute, fail, be retried,
/// or arrive twice. Collapsing the two would let a failed MoMo debit silently
/// change a driver's earnings.
model Payment {
  id      String         @id @default(cuid())
  purpose PaymentPurpose
  status  PaymentStatus  @default(CREATED)

  /// Always positive. The direction is the purpose, not the sign.
  amountXaf Int
  /// The number the money moves to or from, E.164.
  phone     String
  /// "mobile money" or "orange money" — Fapshi's spelling, auto-detected if null.
  medium    String?

  tripId            String?
  trip              Trip?            @relation(fields: [tripId], references: [id])
  driverId          String?
  driver            Driver?          @relation(fields: [driverId], references: [id])
  /// Set for an ACCESS_FEE payment, so a day is never charged twice.
  accessFeeChargeId String?
  accessFeeCharge   AccessFeeCharge? @relation(fields: [accessFeeChargeId], references: [id])

  provider         String  @default("fapshi")
  /// Fapshi's transId. Unique so a webhook replay cannot create a second row.
  providerTransId  String? @unique
  /// The mobile operator's own reference, for when somebody disputes it.
  financialTransId String?
  failureReason    String?

  /// Written once the money actually landed, never before.
  ledgerEntryId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  @@index([status, createdAt])
  @@index([driverId, createdAt])
  @@index([purpose, status])
}

/// What a driver has to hand over before anybody may be dispatched to him.
enum DocumentKind {
  /// The CNI card itself. The number lives on Driver; this is the photograph.
  NATIONAL_ID
  /// Carte grise — proof the car is his to drive.
  VEHICLE_REGISTRATION
  /// His face, which the rider sees before getting in.
  DRIVER_PHOTO
}

/// One uploaded file.
///
/// `key` is an opaque object key in whatever store is configured — never a URL
/// and never public. These are national ID photographs: they are read back only
/// through an authenticated ops route, and never served as static files.
model DriverDocument {
  id          String       @id @default(cuid())
  driverId    String
  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  kind        DocumentKind
  key         String
  contentType String
  byteSize    Int
  uploadedAt  DateTime     @default(now())

  /// One current copy per kind. Re-uploading replaces rather than piles up —
  /// a driver who reshoots a blurry photo should not leave the blurry one behind.
  @@unique([driverId, kind])
  @@index([driverId])
}

/// The bytes behind a document key, when DOCUMENT_STORE is postgres.
///
/// ID cards, registration papers and faces, kept in the database rather than on
/// a disk: they are backed up with everything else, they survive a redeploy on
/// a host whose disk does not, and there is no bucket to leave public by
/// mistake. Nothing reads this table except the store in documents/store.ts,
/// and nothing serves it except the authenticated routes that already did.
model StoredFile {
  /// Generated by the store; never anything a phone sent.
  key         String   @id
  contentType String
  bytes       Bytes
  byteSize    Int
  createdAt   DateTime @default(now())
}
