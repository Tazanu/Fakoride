{
  "$name": "Daylight",
  "$version": "0.2.0",
  "$description": "Fako Ride design tokens. Single source of truth — tokens.ts reads this file, and check-contrast.mjs verifies it. Change a value here, run the check, and both the apps and the ops console follow.",
  "color": {
    "light": {
      "paper": "#FAFAF7",
      "card": "#FFFFFF",
      "ink": "#111A15",
      "inkSoft": "#3F4E46",
      "muted": "#5E6F66",
      "line": "#E2E6DF",
      "lineStrong": "#C9D1C8",
      "action": "#00693E",
      "actionPressed": "#005432",
      "actionTint": "#E6F1EB",
      "actionSurface": "#F3F9F5",
      "onAction": "#FFFFFF",
      "danger": "#C0102E",
      "dangerTint": "#FBE9EC",
      "onDanger": "#FFFFFF",
      "hill": "#8A5200",
      "fill": "#EDEFE8",
      "scrim": "rgba(17, 26, 21, 0.55)"
    },
    "night": {
      "paper": "#101714",
      "card": "#1A231E",
      "ink": "#E8EDE9",
      "inkSoft": "#C2CEC6",
      "muted": "#9FB0A6",
      "line": "#27322C",
      "lineStrong": "#3A4A42",
      "action": "#35C47A",
      "actionPressed": "#2AA967",
      "actionTint": "#15291F",
      "actionSurface": "#15291F",
      "onAction": "#101714",
      "danger": "#FF6B6B",
      "dangerTint": "#2E1616",
      "onDanger": "#101714",
      "hill": "#E0A94A",
      "fill": "#1F2A24",
      "scrim": "rgba(4, 8, 6, 0.72)"
    },
    "brand": {
      "$comment": "Payment brands only. Never use these as app colours — that is precisely why the action colour is green.",
      "mtnMomo": "#FFCC00",
      "orangeMoney": "#FF7900"
    }
  },
  "font": {
    "$comment": "UI text ships in the phone's own font: zero bytes, no flash of invisible text on an Android Go handset. One condensed face is bundled for fares, headings and the wordmark.",
    "ui": {
      "android": "Roboto",
      "ios": "System",
      "web": "Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "display": {
      "family": "Barlow Semi Condensed",
      "weights": [
        600,
        700
      ],
      "web": "'Barlow Semi Condensed', 'Roboto Condensed', 'Arial Narrow', sans-serif",
      "$why": "French runs 20-25% longer than English and short labels expand the most. Semi-condensed absorbs it."
    }
  },
  "type": {
    "$unit": "sp on Android, pt on iOS, px on web",
    "fare": {
      "size": 46,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.0
    },
    "fareSmall": {
      "size": 27,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.0
    },
    "title": {
      "size": 26,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.1
    },
    "heading": {
      "size": 22,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.15
    },
    "body": {
      "size": 16,
      "weight": 500,
      "family": "ui",
      "lineHeight": 1.35
    },
    "bodyPlain": {
      "size": 15,
      "weight": 400,
      "family": "ui",
      "lineHeight": 1.4
    },
    "secondary": {
      "size": 14,
      "weight": 400,
      "family": "ui",
      "lineHeight": 1.4
    },
    "label": {
      "size": 12,
      "weight": 500,
      "family": "ui",
      "letterSpacing": 0.07,
      "uppercase": true
    },
    "$floor": {
      "body": 14,
      "any": 12,
      "$why": "Material's Android minimum is 14sp for body text. v0.1 shipped 9px navigation labels — unreadable one-handed, outdoors, in sun."
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 10,
    "pill": 999
  },
  "touch": {
    "min": 48,
    "gap": 8,
    "primaryButtonMinHeight": 56,
    "secondaryButtonMinHeight": 48,
    "$why": "Material Design 3 minimum is 48x48dp with 8dp between targets. Buttons are min-height with padding, never fixed height — a French label has to wrap without breaking the row."
  },
  "contrastPairs": {
    "$comment": "Asserted by check-contrast.mjs. 4.5 is the WCAG AA floor for body text, 3 for non-text UI that carries meaning on its own.",
    "light": [
      {
        "fg": "ink",
        "bg": "paper",
        "min": 4.5,
        "note": "body text"
      },
      {
        "fg": "ink",
        "bg": "card",
        "min": 4.5,
        "note": "body text on a card"
      },
      {
        "fg": "inkSoft",
        "bg": "card",
        "min": 4.5,
        "note": "secondary text"
      },
      {
        "fg": "muted",
        "bg": "paper",
        "min": 4.5,
        "note": "labels"
      },
      {
        "fg": "muted",
        "bg": "card",
        "min": 4.5,
        "note": "labels on a card"
      },
      {
        "fg": "onAction",
        "bg": "action",
        "min": 4.5,
        "note": "primary button"
      },
      {
        "fg": "action",
        "bg": "card",
        "min": 4.5,
        "note": "action text and verified badge"
      },
      {
        "fg": "action",
        "bg": "actionSurface",
        "min": 4.5,
        "note": "action text on its own tint"
      },
      {
        "fg": "onDanger",
        "bg": "danger",
        "min": 4.5,
        "note": "the help button"
      },
      {
        "fg": "hill",
        "bg": "card",
        "min": 4.5,
        "note": "hill-price note"
      },
      {
        "fg": "action",
        "bg": "paper",
        "min": 3,
        "note": "selected control border"
      }
    ],
    "night": [
      {
        "fg": "ink",
        "bg": "paper",
        "min": 4.5,
        "note": "body text"
      },
      {
        "fg": "inkSoft",
        "bg": "card",
        "min": 4.5,
        "note": "secondary text"
      },
      {
        "fg": "muted",
        "bg": "card",
        "min": 4.5,
        "note": "labels"
      },
      {
        "fg": "onAction",
        "bg": "action",
        "min": 4.5,
        "note": "primary button"
      },
      {
        "fg": "action",
        "bg": "card",
        "min": 4.5,
        "note": "action text"
      },
      {
        "fg": "danger",
        "bg": "card",
        "min": 4.5,
        "note": "help text"
      },
      {
        "fg": "hill",
        "bg": "card",
        "min": 4.5,
        "note": "hill-price note"
      }
    ]
  }
}
