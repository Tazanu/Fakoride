{
  "$name": "Daylight",
  "$version": "0.2.0",
  "$description": "Fako Ride's design system, taken from the design canvas: teal on warm ivory. Semantic names only — a screen asks for `action`, never for a hex, so the palette can move without touching a component.",
  "color": {
    "light": {
      "paper": "#FAF8F5",
      "card": "#FFFFFF",
      "ink": "#14201E",
      "inkSoft": "#3B4A47",
      "muted": "#5C6B68",
      "line": "#EDEAE3",
      "lineStrong": "#D9DCD6",
      "action": "#0F5F58",
      "actionPressed": "#0B4A45",
      "actionTint": "#EEF4F2",
      "actionSurface": "#EEF4F2",
      "onAction": "#FFFFFF",
      "danger": "#A33A3A",
      "dangerTint": "#FBE9EC",
      "onDanger": "#FFFFFF",
      "hill": "#B25208",
      "fill": "#F1EFE9",
      "scrim": "rgba(20, 32, 30, 0.55)",
      "edge": "#E7E4DD",
      "actionBright": "#0D9488",
      "actionText": "#0B7A70",
      "actionTintEdge": "#CFE3DE",
      "onActionSoft": "#BFE3DC",
      "onActionLine": "#1C7268",
      "dangerEdge": "#E0B4B4",
      "amber": "#D97706",
      "amberTint": "#FBF0E0",
      "controlEdge": "#939591",
      "actionDeep": "#0C4E48",
      "onActionEdge": "#4E8E86",
      "onActionMuted": "#9CCFC6",
      "onActionBright": "#7FD4C6",
      "track": "#DFE3DD",
      "fillMuted": "#F1F0EB"
    },
    "night": {
      "paper": "#101714",
      "card": "#1A231E",
      "ink": "#E8EDE9",
      "inkSoft": "#C2CEC6",
      "muted": "#9FB0A6",
      "line": "#27322C",
      "lineStrong": "#3A4A42",
      "action": "#35C47A",
      "actionPressed": "#2AA967",
      "actionTint": "#15291F",
      "actionSurface": "#15291F",
      "onAction": "#101714",
      "danger": "#FF6B6B",
      "dangerTint": "#2E1616",
      "onDanger": "#101714",
      "hill": "#E0A94A",
      "fill": "#1F2A24",
      "scrim": "rgba(4, 8, 6, 0.72)"
    },
    "brand": {
      "$comment": "Payment brands only. Never use these as app colours — that is precisely why the action colour is green.",
      "mtnMomo": "#FFCC00",
      "orangeMoney": "#FF7900"
    },
    "map": {
      "ground": "#E4EBE7",
      "block": "#DAE3DD",
      "ridge": "#D3DED7",
      "road": "#FFFFFF",
      "lane": "#F3F5F2",
      "route": "#0F5F58",
      "here": "#0D9488",
      "pin": "#D97706"
    },
    "$why": "lineStrong is decorative and has no contrast floor; controlEdge is load-bearing and is asserted at 3:1. Splitting them is why the soft grey survives.",
    "logo": {
      "$why": "The welcome badge only. Never interface, never text.",
      "mint": "#5EC4B6",
      "amber": "#F0A93B"
    }
  },
  "font": {
    "$comment": "Two bundled faces, from the design canvas. Archivo carries anything that is read as a number or a heading; Manrope carries everything that is read as a sentence. The phone's own font is no longer used for body text — Manrope's wider apertures survive a cheap LCD in sun better than Roboto does.",
    "display": {
      "family": "Archivo",
      "weights": [
        600,
        700
      ],
      "web": "'Archivo', 'Arial Narrow', sans-serif",
      "$why": "Fares, headings, plate numbers. Tight tracking at large sizes."
    },
    "ui": {
      "family": "Manrope",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "web": "'Manrope', system-ui, sans-serif",
      "$why": "Body, labels, buttons. 600 is the workhorse for anything a thumb aims at."
    }
  },
  "type": {
    "$unit": "sp on Android, pt on iOS, px on web",
    "fare": {
      "size": 42,
      "weight": 700,
      "family": "display",
      "lineHeight": 1,
      "tracking": -1
    },
    "fareSmall": {
      "size": 22,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.1
    },
    "title": {
      "size": 30,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.27,
      "tracking": -0.3
    },
    "titleSmall": {
      "size": 24,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.2,
      "tracking": -0.2
    },
    "heading": {
      "size": 19,
      "weight": 600,
      "family": "display",
      "lineHeight": 1.2
    },
    "plate": {
      "size": 17,
      "weight": 700,
      "family": "display",
      "lineHeight": 1.2,
      "tracking": 0.6
    },
    "body": {
      "size": 16,
      "weight": 400,
      "family": "ui",
      "lineHeight": 1.4
    },
    "bodyStrong": {
      "size": 15,
      "weight": 600,
      "family": "ui",
      "lineHeight": 1.4
    },
    "bodyPlain": {
      "size": 15,
      "weight": 400,
      "family": "ui",
      "lineHeight": 1.53
    },
    "secondary": {
      "size": 13,
      "weight": 400,
      "family": "ui",
      "lineHeight": 1.54
    },
    "secondaryStrong": {
      "size": 13,
      "weight": 600,
      "family": "ui",
      "lineHeight": 1.54
    },
    "label": {
      "size": 13,
      "weight": 600,
      "family": "ui",
      "lineHeight": 1.3
    },
    "button": {
      "size": 17,
      "weight": 700,
      "family": "ui",
      "lineHeight": 1.2
    },
    "$floor": {
      "body": 15,
      "any": 13,
      "$why": "Nothing below 13. A 12sp label is unreadable one-handed, outdoors, in sun."
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 12,
    "md": 14,
    "lg": 16,
    "chip": 22,
    "sheet": 26,
    "pill": 999
  },
  "touch": {
    "min": 48,
    "gap": 8,
    "primaryButtonMinHeight": 56,
    "secondaryButtonMinHeight": 48,
    "$why": "Material Design 3 minimum is 48x48dp with 8dp between targets. Buttons are min-height with padding, never fixed height — a French label has to wrap without breaking the row."
  },
  "contrastPairs": {
    "$comment": "Asserted by check-contrast.mjs. 4.5 is the WCAG AA floor for body text, 3 for non-text UI that carries meaning on its own.",
    "light": [
      {
        "fg": "ink",
        "bg": "paper",
        "min": 4.5,
        "note": "body text"
      },
      {
        "fg": "ink",
        "bg": "card",
        "min": 4.5,
        "note": "body text on a card"
      },
      {
        "fg": "inkSoft",
        "bg": "paper",
        "min": 4.5,
        "note": "secondary text"
      },
      {
        "fg": "inkSoft",
        "bg": "card",
        "min": 4.5,
        "note": "secondary text on a card"
      },
      {
        "fg": "muted",
        "bg": "paper",
        "min": 4.5,
        "note": "labels"
      },
      {
        "fg": "muted",
        "bg": "card",
        "min": 4.5,
        "note": "labels on a card"
      },
      {
        "fg": "onAction",
        "bg": "action",
        "min": 4.5,
        "note": "primary button"
      },
      {
        "fg": "onActionSoft",
        "bg": "action",
        "min": 4.5,
        "note": "labels inside the fare card"
      },
      {
        "fg": "actionText",
        "bg": "card",
        "min": 4.5,
        "note": "teal text and links"
      },
      {
        "fg": "actionText",
        "bg": "paper",
        "min": 4.5,
        "note": "teal text on the ground"
      },
      {
        "fg": "actionText",
        "bg": "actionTint",
        "min": 4.5,
        "note": "teal text on its own tint"
      },
      {
        "fg": "action",
        "bg": "card",
        "min": 4.5,
        "note": "deep teal headings"
      },
      {
        "fg": "action",
        "bg": "actionTint",
        "min": 4.5,
        "note": "the fare on its tint"
      },
      {
        "fg": "hill",
        "bg": "card",
        "min": 4.5,
        "note": "amber note"
      },
      {
        "fg": "hill",
        "bg": "amberTint",
        "min": 4.5,
        "note": "amber on its own tint"
      },
      {
        "fg": "danger",
        "bg": "card",
        "min": 4.5,
        "note": "cancel ride"
      },
      {
        "fg": "actionBright",
        "bg": "card",
        "min": 3.0,
        "note": "focused field and selected tile edge"
      },
      {
        "fg": "controlEdge",
        "bg": "card",
        "min": 3.0,
        "note": "the border that is the only sign a control is there"
      },
      {
        "fg": "onActionSoft",
        "bg": "actionDeep",
        "min": 4.5,
        "note": "labels on the inset well"
      },
      {
        "fg": "onAction",
        "bg": "actionDeep",
        "min": 4.5,
        "note": "stop names on the inset well"
      },
      {
        "fg": "onActionMuted",
        "bg": "actionDeep",
        "min": 4.5,
        "note": "the minutes-away note"
      },
      {
        "fg": "onActionSoft",
        "bg": "action",
        "min": 4.5,
        "note": "decline label on the request card"
      }
    ],
    "night": [
      {
        "fg": "ink",
        "bg": "paper",
        "min": 4.5,
        "note": "body text"
      },
      {
        "fg": "inkSoft",
        "bg": "card",
        "min": 4.5,
        "note": "secondary text"
      },
      {
        "fg": "muted",
        "bg": "card",
        "min": 4.5,
        "note": "labels"
      },
      {
        "fg": "onAction",
        "bg": "action",
        "min": 4.5,
        "note": "primary button"
      },
      {
        "fg": "action",
        "bg": "card",
        "min": 4.5,
        "note": "action text"
      },
      {
        "fg": "danger",
        "bg": "card",
        "min": 4.5,
        "note": "help text"
      },
      {
        "fg": "hill",
        "bg": "card",
        "min": 4.5,
        "note": "hill-price note"
      }
    ]
  }
}
